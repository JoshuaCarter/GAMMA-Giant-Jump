--[[
	Dorn's Giant Jump

	Pseudogiants deal ground-slam damage through the engine's
	"pseudogiant_before_stomp" callback (see callbacks_gameobject.script),
	fired once per nearby object right before the stock hit is applied. It
	hands us a `flags` table - setting flags.ret_value = false cancels that
	one hit outright, before any damage or impulse is calculated.

	We only ever touch the callback for the actor, and only cancel the hit
	while the actor is airborne (jumping or falling) per the engine's own
	movement state - see level.actor_moving_state() / actor_move_states in
	_g.script. Landing recovery (mcLanding/mcLanding2) already counts as
	back on the ground, so it still takes damage - only the actual time
	spent in the air is a free dodge.
]]

local MOD_ID = "dorn_giant_jump"
local DORN_COMMON_VERSION = "dorn_common_7367f5e7" -- managed by sync-dorn-common.sh, do not hand-edit

local DORN

-- level.actor_moving_state() bit flags (see gamedata/scripts/_g.script: actor_move_states).
-- mcJump = jump just triggered, mcFall = currently falling. Deliberately excludes
-- mcLanding/mcLanding2: those fire once the engine has already detected ground contact.
local MC_JUMP = 128
local MC_FALL = 256
local MC_AIRBORNE_MASK = MC_JUMP + MC_FALL

local CONFIG = {
	enabled = true,
	debug_log = false,
}

local LOG = {
	EVENT = { order = 0, color = "yellow" },
}

local function log(slot, msg)
	if DORN and DORN.dbg and CONFIG.debug_log then
		DORN.dbg.write(MOD_ID, slot.order, "[GiantJump] " .. tostring(msg), slot.color)
	end
end

local function on_option_change()
	CONFIG.enabled = DORN.mcm.bool(MOD_ID, "main/enabled", true)
	CONFIG.debug_log = DORN.mcm.bool(MOD_ID, "development/debug_log", false)
	DORN.dbg.set_enabled(MOD_ID, CONFIG.debug_log)
end

local function actor_is_airborne()
	if not level or not level.actor_moving_state or not bit_and then
		return false
	end
	return bit_and(level.actor_moving_state(), MC_AIRBORNE_MASK) ~= 0
end

local function on_before_stomp(victim, who, shit, bone_id, flags)
	local ctx, actor = DORN.sys.ready(MOD_ID, db, on_option_change)
	if not ctx or not flags then
		return
	end

	if not CONFIG.enabled then
		return
	end

	-- Only the player can dodge; leave squadmates/other objects (if the
	-- engine's pseudogiant_can_damage_objects_on_stomp console var is on)
	-- to take the hit as normal.
	if not victim or not actor or victim:id() ~= actor:id() then
		return
	end

	if actor_is_airborne() then
		flags.ret_value = false
		log(LOG.EVENT, "Dodged: actor was airborne on stomp impact")
	else
		log(LOG.EVENT, "Grounded: stomp hit applied")
	end
end

function on_game_start()
	DORN = _G[DORN_COMMON_VERSION].load(MOD_ID)

	RegisterScriptCallback("pseudogiant_before_stomp", on_before_stomp)
	RegisterScriptCallback("on_option_change", on_option_change)
	log(LOG.EVENT, "loaded")
end
